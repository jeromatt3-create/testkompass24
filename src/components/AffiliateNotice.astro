---
interface Props {
  updatedDate?: Date;
}

const { updatedDate } = Astro.props;
const formattedDate = updatedDate
  ? updatedDate.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

